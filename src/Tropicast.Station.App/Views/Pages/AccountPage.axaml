<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tropicast.Station.App.ViewModels"
             xmlns:c="using:Tropicast.Station.App.Controls"
             x:Class="Tropicast.Station.App.Views.Pages.AccountPage"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
    <StackPanel x:Name="Root" Classes="page" x:DataType="vm:AccountViewModel">
      <TextBlock Classes="pageTitle" Text="Account" />
      <TextBlock Classes="pageIntro" Text="Sign this computer in to broadcast to the stations of your Tropicast account." />
      <StackPanel Classes="group" Spacing="8">
        <TextBlock Classes="cardTitle" Text="Tropicast account" />
        <c:SettingsCard>
          <c:SettingRow Title="Sign-in" Description="{Binding Status}">
            <Panel>
              <Button x:Name="AccountSignInButton" Classes="accent" Content="Sign in with Tropicast" Command="{Binding SignInCommand}"
                      IsVisible="{Binding IsSignedOut}" AutomationProperties.Name="Sign in with Tropicast"
                      AutomationProperties.HelpText="Opens the browser to approve this computer. No password is typed here." />
              <Button Content="Cancel" Command="{Binding SignInCancelCommand}" IsVisible="{Binding IsSigningIn}"
                      AutomationProperties.Name="Cancel sign-in" />
              <Button x:Name="SignOutButton" Content="Sign out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
            </Panel>
          </c:SettingRow>
          <c:SettingRow Title="Approve this code in your browser" Description="The page that opened in your browser asks for it."
                        IsVisible="{Binding IsSigningIn}">
            <StackPanel Spacing="8">
              <TextBlock x:Name="AccountUserCode" Classes="code" Text="{Binding UserCode}" FontSize="26" FontWeight="Bold"
                         HorizontalAlignment="Right" AutomationProperties.Name="{Binding UserCode}" />
              <Button Content="Open the page again" Command="{Binding OpenSignInPageCommand}" HorizontalAlignment="Right" />
            </StackPanel>
          </c:SettingRow>
          <c:SettingRow x:Name="TermsNoticeRow" Title="Terms of Service" Description="{Binding TermsNotice}"
                        IsVisible="{Binding HasTermsNotice}">
            <Button Content="Open the web app" Command="{Binding OpenWebAppCommand}"
                    AutomationProperties.Name="Open the Tropicast web app to accept the terms" />
          </c:SettingRow>
          <c:SettingRow Title="Stations" Description="Reload the stations this account can broadcast to." IsVisible="{Binding IsSignedIn}">
            <Button Content="Refresh stations" Command="{Binding RefreshStationsCommand}" />
          </c:SettingRow>
        </c:SettingsCard>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
